# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control!
# ============================================================

# ============================================================
# CORE DJANGO SETTINGS
# ============================================================

# SECURITY WARNING: Generate a unique secret key for production!
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION

# SECURITY WARNING: Set to False in production!
DEBUG=False

# Comma-separated list of allowed hosts
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================

# DATABASE_URL takes precedence in production (read by dj_database_url.config() in
# settings_production.py); DB_* below are the settings.py fallback if DATABASE_URL is unset.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://condominios_user:CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD@postgres:5432/condominios_prod

DB_ENGINE=django.db.backends.postgresql
DB_NAME=condominios_prod
DB_USER=condominios_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# ============================================================
# REDIS CACHE CONFIGURATION
# ============================================================

# OPTIONAL (recommended) — when unset, settings_production.py emits a RuntimeWarning at
# startup: rate limiting (incl. the 10/minute auth throttle) degrades to an unenforced
# per-process in-memory cache. Set it as soon as a Redis instance is available.
REDIS_URL=redis://redis:6379/0
CACHE_TIMEOUT=300
CACHE_MIDDLEWARE_SECONDS=300

# ============================================================
# CORS SETTINGS
# ============================================================

# Comma-separated list of allowed origins
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# ============================================================
# GOOGLE OAUTH CREDENTIALS
# ============================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
#
# In the Google OAuth 2.0 Client (Web application) configure:
#   Authorized JavaScript origins:
#     - https://SEU_DOMINIO
#   Authorized redirect URI (allauth callback on the backend):
#     - https://SEU_DOMINIO/accounts/google/login/callback/

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google emails promoted to admin (is_staff + is_superuser) on login (comma-separated)
ADMIN_GOOGLE_EMAILS=

# Origins trusted for CSRF — the backend host handling the OAuth redirect (comma-separated)
CSRF_TRUSTED_ORIGINS=https://SEU_DOMINIO

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

FRONTEND_URL=https://yourdomain.com
FRONTEND_AUTH_CALLBACK_PATH=/auth/callback

# ============================================================
# JWT TOKEN SETTINGS
# ============================================================

# Access lifetime in MINUTES, refresh lifetime in DAYS (settings.py reads these exact names)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256

# ============================================================
# TWILIO / WHATSAPP + AUTH COOKIE + CELERY (read by settings.py)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_VERIFICATION=
TWILIO_TEMPLATE_RENT_ADJUSTMENT=
TWILIO_TEMPLATE_GENERIC=
AUTH_COOKIE_SAMESITE=None
CELERY_BROKER_URL=

# ============================================================
# PDF GENERATION SETTINGS
# ============================================================

# Path to Chrome/Chromium executable in Docker container
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
PDF_OUTPUT_DIR=/app/contracts
PDF_GENERATION_TIMEOUT=30

# ============================================================
# APPLICATION CONSTANTS
# ============================================================

DEFAULT_TAG_FEE_SINGLE=20.00
DEFAULT_TAG_FEE_MULTIPLE=40.00
LATE_FEE_PERCENTAGE=0.05
DAYS_PER_MONTH=30

# ============================================================
# WEB PUSH (VAPID) — notificações push na web
# ============================================================
# Gerar o par de chaves UMA ÚNICA VEZ (formato base64url aceito pelo pywebpush) e
# guardar no secret manager do Render (backend):
#   uv run python manage.py generate_vapid_keys
# NÃO use os .pem do `vapid --gen`: a chave privada em PEM não carrega como string de env.
# A pública (≈87 chars) é exposta ao front via /api/web-push/vapid-public-key/; a privada
# (≈43 chars) é SECRETA. As 3 variáveis ficam SÓ no Render (o Vercel não precisa de nenhuma).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================================
# REST FRAMEWORK SETTINGS
# ============================================================

PAGE_SIZE=20

# ============================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================

# SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# SERVER_EMAIL is the From address Django uses for error emails to ADMINS (defaults to
# DEFAULT_FROM_EMAIL above if unset)
SERVER_EMAIL=noreply@yourdomain.com

# ADMIN_EMAIL receives Django error notification emails (settings_production.py ADMINS)
ADMIN_EMAIL=admin@yourdomain.com

# ============================================================
# SENTRY ERROR TRACKING (Optional - Recommended for production)
# ============================================================

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# APP_VERSION tags the Sentry release (settings_production.py); set from your deploy's
# git SHA or version tag
APP_VERSION=1.0.0

# ============================================================
# AWS S3 STORAGE (Optional - for static/media files)
# ============================================================

USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your-bucket-name.s3.amazonaws.com
